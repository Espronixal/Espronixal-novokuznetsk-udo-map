            {"school_name": "Муниципальное образовательное учреждение\"Ильинская средняя общеобразовательная школа", "school_lat": 53.89843, "school_lon": 87.1659, "nearest_udo": "МБ ОУ ДО «Дом детского творчества № 5»", "distance_km": 2.78, "accessible": true, "enrollment_age": "6–17 лет"}
        ];

        var uniqueUdos = {};
        schoolsData.forEach(function(school) {
            if (!uniqueUdos[school.nearest_udo]) {
                var baseLat = school.school_lat;
                var baseLon = school.school_lon;
                var fakeLat = baseLat + (Math.random() - 0.5) * 0.002;
                var fakeLon = baseLon + (Math.random() - 0.5) * 0.002;
                uniqueUdos[school.nearest_udo] = {name: school.nearest_udo, lat: fakeLat, lon: fakeLon};
            }
        });
        var udoData = Object.values(uniqueUdos);

        var greenIcon = L.divIcon({
            className: 'school-icon-available',
            html: '✓',
            iconSize: [24, 24],
            iconAnchor: [12, 12]
        });
        var redIcon = L.divIcon({
            className: 'school-icon-unavailable',
            html: '<div class="cross"></div>',
            iconSize: [24, 24],
            iconAnchor: [12, 12]
        });
        var pinkIcon = L.divIcon({
            className: 'udo-icon',
            html: 'ДО',
            iconSize: [24, 24],
            iconAnchor: [12, 12]
        });

        var availableSchoolsLayer = L.layerGroup();
        var unavailableSchoolsLayer = L.layerGroup();
        var udoLayer = L.layerGroup();

        schoolsData.forEach(function(school) {
            var icon = school.accessible ? greenIcon : redIcon;
            var marker = L.marker([school.school_lat, school.school_lon], { icon: icon });
            var popup = `<b>${school.school_name}</b><br>Ближайшее УДО: ${school.nearest_udo}<br>Расстояние: ${school.distance_km} км<br>Доступно: ${school.accessible ? '✅ Да' : '❌ Нет'}<br>Возраст зачисления: ${school.enrollment_age}`;
            marker.bindPopup(popup);

            if (school.accessible) {
                availableSchoolsLayer.addLayer(marker);
            } else {
                unavailableSchoolsLayer.addLayer(marker);
            }

            var match = school.school_name.match(/(?:школа|гимназия|лицей)\s*№?\s*(\d+)/i);
            var name = match ? `Школа №${match[1]}` : school.school_name;
            var opt = document.createElement('option');
            opt.value = school.school_name;
            opt.text = name;
            document.getElementById('school-select').appendChild(opt);
        });

        udoData.forEach(function(udo) {
            var marker = L.marker([udo.lat, udo.lon], { icon: pinkIcon });
            marker.bindPopup(`<b>${udo.name}</b>`);
            udoLayer.addLayer(marker);
        });

        function updateLayers() {
            var showAvailable = document.getElementById('toggle-available').checked;
            var showUnavailable = document.getElementById('toggle-unavailable').checked;
            var showUdo = document.getElementById('toggle-udo').checked;

            if (showAvailable && !map.hasLayer(availableSchoolsLayer)) map.addLayer(availableSchoolsLayer);
            if (!showAvailable && map.hasLayer(availableSchoolsLayer)) map.removeLayer(availableSchoolsLayer);

            if (showUnavailable && !map.hasLayer(unavailableSchoolsLayer)) map.addLayer(unavailableSchoolsLayer);
            if (!showUnavailable && map.hasLayer(unavailableSchoolsLayer)) map.removeLayer(unavailableSchoolsLayer);

            if (showUdo && !map.hasLayer(udoLayer)) map.addLayer(udoLayer);
            if (!showUdo && map.hasLayer(udoLayer)) map.removeLayer(udoLayer);
        }

        map.addLayer(availableSchoolsLayer);
        map.addLayer(unavailableSchoolsLayer);
        map.addLayer(udoLayer);

        document.getElementById('toggle-available').addEventListener('change', updateLayers);
        document.getElementById('toggle-unavailable').addEventListener('change', updateLayers);
        document.getElementById('toggle-udo').addEventListener('change', updateLayers);

        function showSchoolAndNearbyUdo(schoolName) {
            var selected = schoolsData.find(s => s.school_name === schoolName);
            if (!selected) return;

            map.setView([selected.school_lat, selected.school_lon], 14);

            map.removeLayer(availableSchoolsLayer);
            map.removeLayer(unavailableSchoolsLayer);
            map.removeLayer(udoLayer);

            var icon = selected.accessible ? greenIcon : redIcon;
            var schoolMarker = L.marker([selected.school_lat, selected.school_lon], { icon: icon });
            var popup = `<b>${selected.school_name}</b><br>Ближайшее УДО: ${selected.nearest_udo}<br>Расстояние: ${selected.distance_km} км<br>Доступно: ${selected.accessible ? '✅ Да' : '❌ Нет'}<br>Возраст зачисления: ${selected.enrollment_age}`;
            schoolMarker.bindPopup(popup).addTo(map);

            if (document.getElementById('toggle-udo').checked) {
                udoData.forEach(function(udo) {
                    var udoLatLng = L.latLng(udo.lat, udo.lon);
                    var schoolLatLng = L.latLng(selected.school_lat, selected.school_lon);
                    var dist = map.distance(schoolLatLng, udoLatLng) / 1000;
                    if (dist <= 3) {
                        var udoMarker = L.marker([udo.lat, udo.lon], { icon: pinkIcon });
                        udoMarker.bindPopup(`<b>${udo.name}</b>`).addTo(map);
                    }
                });
            }
        }

        document.getElementById('school-select').addEventListener('change', function() {
            if (this.value === 'all') {
                updateLayers();
            } else {
                showSchoolAndNearbyUdo(this.value);
            }
        });
